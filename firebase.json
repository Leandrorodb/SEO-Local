{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source":"/v1/**","function":{"functionId":"api","region":"southamerica-east1"}},
      {"source":"/health","function":{"functionId":"api","region":"southamerica-east1"}},
      {"source":"**","destination":"/index.html"}
    ],
    "headers": [{"source":"**","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Cache-Control","value":"no-cache"}
    ]}]
  },
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"},
  "functions": [{"source":"functions","codebase":"seo-local","runtime":"nodejs24","predeploy":["npm run build:firebase"],"ignore":["node_modules",".git","*.log"]}],
  "emulators": {
    "auth":{"host":"127.0.0.1","port":9099},
    "firestore":{"host":"127.0.0.1","port":8080},
    "hosting":{"host":"127.0.0.1","port":5000},
    "ui":{"enabled":true,"host":"127.0.0.1","port":4000},
    "singleProjectMode":true
  }
}
