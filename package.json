{
  "name": "local-rank-tracker",
  "version": "4.8.1-rank-proof-buildfix",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/main.js",
    "lint": "tsc --noEmit",
    "api": "node --env-file-if-exists=.env --import tsx apps/api/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/main.ts",
    "worker:http": "node --env-file-if-exists=.env --import tsx apps/worker/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && tsx infra/build-server.ts",
    "contract": "tsx infra/generate-contract.ts",
    "format": "prettier --write apps packages infra tests package.json tsconfig.json",
    "test": "tsx --test tests/*.test.ts tests/integration/*.test.ts",
    "test:legacy": "node --test legacy/tests/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/migrate.ts",
    "db:local": "tsx infra/local-postgres.ts",
    "owner:bootstrap": "node --env-file-if-exists=.env --import tsx infra/bootstrap-owner.ts",
    "preview:enable": "node --env-file=.env --import tsx infra/enable-local-preview.ts",
    "auth:local:setup": "node infra/local-oidc.mjs setup",
    "auth:local:serve": "node --env-file-if-exists=.env infra/local-oidc.mjs serve",
    "auth:local:otp": "node infra/local-oidc.mjs otp",
    "auth:local:test": "node --test tests/local-oidc.test.mjs",
    "local:workspace": "node --env-file-if-exists=.env --import tsx infra/bootstrap-local-workspace.ts",
    "preview:local": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "api:built": "node --env-file-if-exists=.env dist/apps/api/main.js",
    "worker:built": "node --env-file-if-exists=.env dist/apps/worker/main.js",
    "test:maps-detail": "node --experimental-strip-types --test tests/maps-detail.test.mjs",
    "build:firebase": "tsx infra/build-firebase.ts",
    "build:review": "node infra/build-review.mjs",
    "build:hosted": "node infra/build-hosted.mjs",
    "collector:local": "node --import tsx infra/run-firebase-collector.mjs",
    "firebase:api": "node --env-file-if-exists=.env --import tsx apps/firebase/dev.ts",
    "server:firebase": "node --env-file-if-exists=.env --import tsx apps/firebase/server.ts",
    "worker:collector": "node --env-file-if-exists=.env --import tsx apps/firebase/collector-runner.ts",
    "worker:collector:once": "node --env-file-if-exists=.env --import tsx apps/firebase/collector-runner.ts --once",
    "build:render": "tsx infra/build-render.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@tanstack/react-query": "^5.90.5",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.6.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "jose": "^6.1.0",
    "oidc-client-ts": "^3.3.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pngjs": "7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.12",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "^18.1.0-beta.16",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
