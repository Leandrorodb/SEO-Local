rules_version = '2';
// Data model: users/{uid} contains private identity and server-managed roles.
// organizations/{org}/members, locations, keywords, grids, audits, tasks,
// measurements, evidence, reports, schedules, branding and logs are private.
// All mutations and reads use the authenticated backend. The Admin SDK bypasses
// these rules, so API handlers must verify membership, role and entitlement.
// No browser may write a rank, permission, payment, report approval or identity.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
